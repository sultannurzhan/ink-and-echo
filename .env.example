# Backend deployment only. Copy to ignored .env.local and use your verified
# personal account and this app's D1 database. Never enable billing for this app.
CLOUDFLARE_ACCOUNT_ID=replace-with-your-personal-account-id
CLOUDFLARE_D1_DATABASE_ID=replace-with-your-d1-database-id
CLOUDFLARE_D1_DATABASE_NAME=ink-and-echo

# Public URL, not a secret. Set after the backend is deployed.
# Use http://127.0.0.1:8787 for local split-frontend development.
INK_API_ORIGIN=https://replace-with-your-worker.workers.dev
